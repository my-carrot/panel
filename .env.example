# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# JinHub API Configuration
JINHUB_API_URL=https://jinhub.my.id
ADMIN_TOKEN=your_admin_token_here

# Reset Cooldown Configuration (in hours)
RESET_COOLDOWN_HOURS=48

# Discord Channel IDs (optional - for logging and permanent panel)
RESET_LOG_CHANNEL_ID=

# Permanent Panel Configuration (optional)
# After running /setup-panel, add these values:
PANEL_CHANNEL_ID=
PANEL_MESSAGE_ID=
